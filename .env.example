# ==============================================================================
# OpenShelf - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env before starting the application.
# NEVER commit real API keys, passwords, or secrets to version control.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Frontend Vite Port
PORT=8443

# Backend Express API Port
BACKEND_PORT=5000

# Base URL for API requests (in dev, proxied via Vite to http://localhost:5000)
VITE_API_URL=/api

# JWT Authentication Secret (Local fallback)
JWT_SECRET=replace-with-a-secure-random-64-character-secret-in-production
JWT_EXPIRES_IN=7d

# Institutional Moderator Security Passkey (Required for Moderator Role)
MODERATOR_SECRET_KEY=OPENSHELF_MOD_2026

# Allowed Cross-Origin Resource Sharing (CORS) Origins (comma-separated)
CORS_ORIGIN=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173

# Rate Limiting Configurations (Protection against DoS & brute-force)
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPLOAD_MAX=25
RATE_LIMIT_ACTION_MAX=40

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx

# ==============================================================================
# AWS Cloud Configuration (Required for Live Cloud Integration)
# ==============================================================================
# AWS Region (e.g., us-east-1, us-west-2, ap-south-1)
AWS_REGION=us-east-1

# IAM User Access Credentials (Leave empty if running on EC2 with an attached IAM Role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional Session Token (if using temporary AWS Academy / AWS Educate credentials)
AWS_SESSION_TOKEN=

# Amazon S3 Storage
# Name of your private S3 bucket for storing educational files
AWS_S3_BUCKET_NAME=openshelf-learning-files
# Expiration for pre-signed upload/download URLs in seconds (default: 900 = 15 mins)
AWS_S3_PRESIGNED_EXPIRY=900

# Amazon DynamoDB
# Table name prefix to separate environments (e.g., OpenShelf-Dev-, OpenShelf-)
AWS_DYNAMODB_TABLE_PREFIX=OpenShelf-

# Amazon SNS (Simple Notification Service)
# ARN of SNS topics for email notifications
AWS_SNS_RESOURCE_UPDATES_TOPIC_ARN=
AWS_SNS_MODERATION_TOPIC_ARN=

# Amazon CloudWatch Monitoring
AWS_CLOUDWATCH_NAMESPACE=OpenShelf/API
AWS_CLOUDWATCH_LOG_GROUP=/aws/openshelf/api

# Amazon Cognito Authentication (Optional - for Cognito user pool auth)
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
