# ==============================================================================
# OpenShelf - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env before starting the application.
# NEVER commit real API keys, passwords, or secrets to version control.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Frontend Vite Port
PORT=8443

# Backend Express API Port
BACKEND_PORT=5000

# Base URL for API requests (in dev, proxied via Vite to http://localhost:5000)
VITE_API_URL=/api

# JWT Authentication Secret
# In production, generate a secure random 256-bit string:
# e.g. using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace-with-a-secure-random-64-character-secret-in-production
JWT_EXPIRES_IN=7d

# Allowed Cross-Origin Resource Sharing (CORS) Origins (comma-separated)
CORS_ORIGIN=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173

# Rate Limiting Configurations (Protection against DoS & brute-force)
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPLOAD_MAX=25
RATE_LIMIT_ACTION_MAX=40

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx
