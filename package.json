{
  "name": "openshelf",
  "description": "A modern, community-driven digital library and revision platform for educational resources.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env server/index.ts",
    "server:dev": "node --env-file=.env --watch server/index.ts",
    "test:aws": "node --env-file=.env server/aws/testConnection.ts",
    "init:dynamo": "node --env-file=.env server/scripts/initDynamoDb.ts",
    "init:s3": "node --env-file=.env server/scripts/initS3.ts",
    "init:cognito": "node --env-file=.env server/scripts/initCognito.ts",
    "init:sns": "node --env-file=.env server/scripts/initSns.ts",
    "init:aws": "npm run init:dynamo && npm run init:s3 && npm run init:sns && npm run init:cognito",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt src"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1152.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sns": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.5.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici-types": "^8.12.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
